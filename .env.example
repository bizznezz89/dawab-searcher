MODE=paper

DAWAB_STATE_URL=https://dawabit.tech/searcher/state.json

POLL_INTERVAL_MS=5000
MAX_STATE_AGE_MS=300000

# Independent RPC verification cadence used by npm run watch.
VERIFY_INTERVAL_MS=60000

# Feed-vs-RPC output difference allowed before verification fails.
# 10 bps = 0.10%.
VERIFY_TOLERANCE_BPS=10

# Bring your own Ethereum provider.
# Recommended: infura.io, alchemy.com, or tatum.io.
ETHEREUM_RPC_URL=

# Optional API key header for providers that require one.
# Tatum: set this to your private API key (sent as x-api-key).
# Infura/Alchemy: normally leave blank if auth is already in the URL.
ETHEREUM_RPC_API_KEY=

# Public Robinhood Chain RPC works out of the box.
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Live execution is disabled by default.
ENABLE_EXECUTION=false
